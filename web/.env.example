# Same project as the iPhone app. Copy into .env.local. Do not commit the key.
# In an xcconfig the URL is written as https:/$()/…. Here it is a normal https URL.
VITE_SUPABASE_URL=https://kjmlaxbpblndbybzvdbd.supabase.co
VITE_SUPABASE_ANON_KEY=
# Services ID from Apple Developer, linked to the app com.ivan.rookraid.
# Also add this ID under Supabase → Authentication → Apple → Client IDs,
# next to the iOS bundle ID, so a web login and an iPhone login are one account.
# Return URL to register at Apple: the site origin plus a slash, for example https://play.example.com/
VITE_APPLE_CLIENT_ID=
