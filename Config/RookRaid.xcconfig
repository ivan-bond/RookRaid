// Build-Einstellungen des App-Targets. Secrets.xcconfig ist optional: fehlt sie, bleiben die Werte leer und die App offline.
RR_SUPABASE_URL =
RR_SUPABASE_ANON_KEY =
// Domain der Browser-Fassung (ohne https://), z. B. play.rookraid.app. Einladungslinks https://<Domain>/f/<Code>
// öffnen dann direkt die App (Universal Links, Datei web/public/.well-known/apple-app-site-association).
// Leer: Die App teilt nur den Freundescode, ohne Link.
RR_WEB_DOMAIN = rookraid.com

#include? "Secrets.xcconfig"
